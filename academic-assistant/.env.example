# Groq API Key (Required for ask.py and Groq LLM calls)
GROQ_API_KEY=your_groq_api_key_here

# Groq Models (Optional overrides, defaults set in config.py)
GROQ_MODEL_MAIN=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b

# Embedding & ChromaDB Configuration (Optional overrides)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
CHROMA_PERSIST_DIRECTORY=backend/data/chroma
CHROMA_COLLECTION_NAME=academic_papers

# Chunking & Retrieval Configuration
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
# Cheap pre-filter threshold (calibrated from scripts/calibrate_threshold.py)
RELEVANCE_THRESHOLD=0.25
LLM_CALL_DELAY_SECONDS=2
MAX_PROMPT_TOKENS=3000
