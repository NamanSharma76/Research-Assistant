# ========================================================
# Environment Configuration for Academic Research Assistant
# Copy this file to .env and configure your secret credentials:
#   PowerShell: copy .env.example .env
#   Bash:       cp .env.example .env
# ========================================================

# Groq API Key (Required for LLM generation and multi-agent synthesis)
# Obtain a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# JWT Secret Key (Required for user authentication sessions)
# Generate a secure random string (minimum 32 characters), e.g. using:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string_32chars_min

# Optional Model Overrides (defaults defined in config.py)
# GROQ_MODEL_MAIN=openai/gpt-oss-120b
# GROQ_MODEL_FAST=openai/gpt-oss-20b

# Optional Container & Storage Overrides (defaults handled automatically in docker-compose.yml)
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# DATABASE_URL=sqlite:////app/data/app.db
# DATA_DIR=/app/data
# CHROMA_PERSIST_DIRECTORY=/app/data/chroma
